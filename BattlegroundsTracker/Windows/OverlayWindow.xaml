<Window x:Class="Hearthstone_Deck_Tracker.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hearthstone_Deck_Tracker"
        xmlns:windows="clr-namespace:Hearthstone_Deck_Tracker.Windows"
        xmlns:overlay="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay"
        xmlns:battlegrounds="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds"
        xmlns:battlegroundsSession="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Session"
        xmlns:battlegroundsTrinkets="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.TrinketPicking"
        xmlns:heroPowerPicking="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.HeroPowerPicking"
        xmlns:tier7="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Tier7"
        xmlns:ext="clr-namespace:Hearthstone_Deck_Tracker.Utility.Extensions"
        xmlns:anim="clr-namespace:Hearthstone_Deck_Tracker.Utility.Animations"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:heroPicking="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.HeroPicking"
        xmlns:inspiration="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Inspiration"
        xmlns:guides="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Guides"
        xmlns:minions="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Minions"
        xmlns:anomalies="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Guides.Anomalies"
        xmlns:chinaModule="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.ChinaModule"
        xmlns:bgsAutomation="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Automation"
        xmlns:minionPinning="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.MinionPinning"
        lex:LocalizeDictionary.DesignCulture="en"
        lex:ResxLocalizationProvider.DefaultAssembly="BattlegroundsTracker"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="HearthstoneOverlay" Height="571" Width="832" Background="{x:Null}" ResizeMode="NoResize"
        ShowInTaskbar="False" SourceInitialized="Window_SourceInitialized_1" AllowsTransparency="True"
        Loaded="OverlayWindow_OnLoaded" Deactivated="OverlayWindow_OnDeactivated"
        WindowStyle="None" Topmost="True" Closing="Window_Closing">
    <Grid Name="GridMain" ClipToBounds="True">
            <!-- Transparent geometry filling the window, so any external capture of the overlay
                 has stable bounds to align to even when no overlay element is visible. Must not wrap
                 CanvasInfo, that would offset the whole overlay by the border thickness. -->
            <Border BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
            <Canvas Name="CanvasInfo" HorizontalAlignment="Left" Height="571" VerticalAlignment="Top" Width="832">
                <Grid Name="GuidesTooltipTrigger" Width="{Binding Width}" Height="{Binding Height}" Canvas.Top="{Binding Top}" Canvas.Left="{Binding Left}"
                      ext:OverlayExtensions.IsOverlayHoverVisible="True" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="{Binding TooltipPlacement}" ToolTipService.HorizontalOffset="{Binding TooltipHorizontalOffset}" ToolTipService.VerticalOffset="{Binding TooltipVerticalOffset}"
                      ext:OverlayExtensions.ToolTipAlignment="{Binding TooltipAlignment}">
                    <Grid.DataContext>
                        <windows:CardGridTooltipViewModel/>
                    </Grid.DataContext>
                    <ext:OverlayExtensions.ToolTip>
                        <guides:GuideTooltipContainer Cards="{Binding Cards}" Visibility="{Binding Cards, Converter={StaticResource NullableToVisibility}}">
                            <guides:GuideTooltipContainer.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                            </guides:GuideTooltipContainer.LayoutTransform>
                            <guides:GuideTooltipContainer.Style>
                                <Style TargetType="guides:GuideTooltipContainer">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </guides:GuideTooltipContainer.Style>
                        </guides:GuideTooltipContainer>
                    </ext:OverlayExtensions.ToolTip>
                </Grid>
                <Grid Name="DiscoveryGuidesTooltipTrigger" Width="{Binding Width}" Height="{Binding Height}" Canvas.Top="{Binding Top}" Canvas.Left="{Binding Left}"
                      ext:OverlayExtensions.IsOverlayHoverVisible="True" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="{Binding TooltipPlacement}" ToolTipService.HorizontalOffset="{Binding TooltipHorizontalOffset}" ToolTipService.VerticalOffset="{Binding TooltipVerticalOffset}"
                      ext:OverlayExtensions.ToolTipAlignment="{Binding TooltipAlignment}">
                    <Grid.DataContext>
                        <windows:CardGridTooltipViewModel/>
                    </Grid.DataContext>
                    <ext:OverlayExtensions.ToolTip>
                        <guides:GuideTooltipContainer Cards="{Binding Cards}" Visibility="{Binding Cards, Converter={StaticResource NullableToVisibility}}">
                            <guides:GuideTooltipContainer.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                            </guides:GuideTooltipContainer.LayoutTransform>
                            <guides:GuideTooltipContainer.Style>
                                <Style TargetType="guides:GuideTooltipContainer">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </guides:GuideTooltipContainer.Style>
                        </guides:GuideTooltipContainer>
                    </ext:OverlayExtensions.ToolTip>
                </Grid>
                <Grid MouseEnter="AnomalyGuidesMulliganTrigger_OnMouseEnter" MouseLeave="AnomalyGuidesMulliganTrigger_OnMouseLeave" Name="AnomalyGuidesMulliganTrigger" Width="{Binding Width}" Height="{Binding Height}" Canvas.Top="{Binding Top}" Canvas.Left="{Binding Left}"
                      ext:OverlayExtensions.IsOverlayHoverVisible="True" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="{Binding TooltipPlacement}" ToolTipService.HorizontalOffset="{Binding TooltipHorizontalOffset}" ToolTipService.VerticalOffset="{Binding TooltipVerticalOffset}">
                    <Grid.DataContext>
                        <windows:CardGridTooltipViewModel/>
                    </Grid.DataContext>
                    <ext:OverlayExtensions.ToolTip>
                        <anomalies:AnomalyGuideTooltip Cards="{Binding Cards}" Visibility="{Binding Cards, Converter={StaticResource NullableToVisibility}}">
                            <anomalies:AnomalyGuideTooltip.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                            </anomalies:AnomalyGuideTooltip.LayoutTransform>
                            <anomalies:AnomalyGuideTooltip.Style>
                                <Style TargetType="anomalies:AnomalyGuideTooltip">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </anomalies:AnomalyGuideTooltip.Style>
                        </anomalies:AnomalyGuideTooltip >
                    </ext:OverlayExtensions.ToolTip>
                </Grid>

                <StackPanel>
                    <local:HearthstoneTextBlock x:Name="TextBlockRestartWarning" Text="{lex:Loc Overlay_Label_Restart}" Visibility="Collapsed" Margin="3" FontSize="16" Fill="Red"/>
                </StackPanel>

                <!-- Dead for N turns labels of the Battlegrounds leaderboard, positioned in code -->
                <local:HearthstoneTextBlock x:Name="BattlegroundsTileText0" Margin="2 -13 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" TextAlignment="Center"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTurnText0" Margin="2.5 0 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" FontStretch="UltraCondensed" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTileText1" Margin="2 -14 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" TextAlignment="Center"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTurnText1" Margin="2.5 -2 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" FontStretch="UltraCondensed" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTileText2" Margin="1 -15 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" TextAlignment="Center"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTurnText2" Margin="2 -3 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" FontStretch="UltraCondensed" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTileText3" Margin=".5 -15 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" TextAlignment="Center"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTurnText3" Margin=".5 -3 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" FontStretch="UltraCondensed" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTileText4" Margin="0 -13 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" TextAlignment="Center"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTurnText4" Margin="0.5 -1 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" FontStretch="UltraCondensed" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTileText5" Margin="-2 -14 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" TextAlignment="Center"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTurnText5" Margin="-1.5 -2 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" FontStretch="UltraCondensed" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTileText6" Margin="-1.5 -13 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" TextAlignment="Center"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTurnText6" Margin="-1 -1 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" FontStretch="UltraCondensed" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTileText7" Margin="-2.5 -11 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" TextAlignment="Center"/>
                <local:HearthstoneTextBlock x:Name="BattlegroundsTurnText7" Margin="-2 1 0 0" Width="{Binding BattlegroundsTileWidth, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" Height="{Binding BattlegroundsTileHeight, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" FontSize="15" FontStretch="UltraCondensed" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Allows Inspiration overlay to be dismissible via background click. Should be below all BGs overlay elements -->
                <Grid Background="Black" Opacity="0.01" Canvas.Top="0" Canvas.Left="0"
                      Width="{Binding Width, ElementName=CanvasInfo}" Height="{Binding Height, ElementName=CanvasInfo}"
                      Visibility="{Binding Visibility, ElementName=BattlegroundsInspiration}"
                      ext:OverlayExtensions.IsOverlayHitTestVisible="True"
                      MouseDown="BgsInspirationCover_OnMouseDown" />

                <StackPanel Name="BattlegroundsSessionStackPanel" Width="auto" Height="auto"
                            Visibility="Collapsed" anim:FadeAnimation.Visibility="Collapsed"
                            anim:FadeAnimation.Direction="Down" anim:FadeAnimation.Distance="20" anim:FadeAnimation.Duration="0:0:0.2">
                    <battlegroundsSession:BattlegroundsSession
                        x:Name="BattlegroundsSession"
                        DataContext="{Binding BattlegroundsSessionViewModelVM, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"
                        CornerRadius="5"
                        FinalBoardTooltip="true"
                    />
                </StackPanel>
                <overlay:BobsBuddyPanel x:Name="BobsBuddyDisplay" Visibility="Collapsed"/>
                <StackPanel Width="1200" Name="BgsOpponentInfoContainer" Canvas.Top="0" Canvas.Right="0">
                    <battlegrounds:BattlegroundsOpponentInfo x:Name="BgsOpponentInfo" Visibility="Collapsed"/>
                </StackPanel>
                <overlay:BattlegroundsHeroPanel x:Name="HeroNotificationPanel" Visibility="Collapsed" Canvas.Right="0"/>

                <heroPicking:BattlegroundsHeroPicking
                    x:Name="BattlegroundsHeroPicking"
                    DataContext="{Binding BattlegroundsHeroPickingViewModel, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"
                />
                <battlegrounds:BattlegroundsQuestPicking
                    x:Name="BattlegroundsQuestPicking"
                    DataContext="{Binding BattlegroundsQuestPickingViewModel, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"
                />
                <battlegroundsTrinkets:BattlegroundsTrinketPicking
                    x:Name="BattlegroundsTrinketPicking"
                    DataContext="{Binding BattlegroundsTrinketPickingViewModel, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"
                />
                <heroPowerPicking:BattlegroundsHeroPowerPicking
                    x:Name="BattlegroundsHeroPowerPicking"
                    DataContext="{Binding BattlegroundsHeroPowerPickingViewModel, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"
                />

                <tier7:Tier7PreLobby x:Name="Tier7PreLobby" Canvas.Top="0" Canvas.Left="0" Visibility="Collapsed"
                                     DataContext="{Binding Tier7PreLobbyViewModel, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"/>

                <!-- Allows Minion Browser overlay to be dismissible via background click -->
                <Grid Background="Black" Opacity="0.01" Canvas.Top="0" Canvas.Left="0"
                      Width="{Binding Width, ElementName=CanvasInfo}" Height="{Binding Height, ElementName=CanvasInfo}"
                      Visibility="{Binding BattlegroundsMinionsVM.IsFiltersOpen, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}, Converter={StaticResource BoolToVisibility}}"
                      ext:OverlayExtensions.IsOverlayHitTestVisible="True"
                      MouseDown="BgsMinionsFilterCover_OnMouseDown" />

                <StackPanel Name="BgsTopBar" Orientation="Horizontal" Visibility="Collapsed" Canvas.Top="0" Canvas.Right="0">
                    <inspiration:BattlegroundsInspirationOverlayButton
                        x:Name="BtnTier7Inspiration" IsEnabled="False" MouseUp="BtnBgsInspiration_OnMouseUp"
                        ext:OverlayExtensions.IsOverlayHitTestVisible="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}}"
                    />
                    <overlay:TurnCounter x:Name="TurnCounter" Height="49" VerticalAlignment="Top">
                        <overlay:TurnCounter.RenderTransform>
                            <TranslateTransform />
                        </overlay:TurnCounter.RenderTransform>
                        <overlay:TurnCounter.Style>
                            <Style TargetType="overlay:TurnCounter">
                                <Style.Resources>
                                    <CubicEase x:Key="Ease" EasingMode="EaseOut"/>
                                </Style.Resources>
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.IsFilterButtonVisible, ElementName=BattlegroundsMinions}" Value="True" />
                                            <Condition Binding="{Binding Visibility, ElementName=GuidesTabs}" Value="Collapsed" />
                                        </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="-46" Duration="0:0:0.2" EasingFunction="{StaticResource Ease}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="0" Duration="0:0:0.2" EasingFunction="{StaticResource Ease}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </overlay:TurnCounter.Style>
                    </overlay:TurnCounter>
                    <guides:GuidesTabs
                        x:Name="GuidesTabs"
                        VerticalAlignment="Top"
                        DataContext="{Binding BattlegroundsGuidesTabsViewModel, RelativeSource={RelativeSource AncestorType={x:Type windows:OverlayWindow}}}"
                        />
                    <minions:BattlegroundsMinions
                        VerticalAlignment="Top"
                        x:Name="BattlegroundsMinions"
                        Visibility="Collapsed"
                        IsStandAloneMode="True"
                        ext:OverlayExtensions.IsOverlayHitTestVisible="True"
                        DataContext="{Binding BattlegroundsMinionsVM, RelativeSource={RelativeSource AncestorType={x:Type windows:OverlayWindow}}}"
                    />
                </StackPanel>

                <Grid Name="BgsMinionPinning"
                      Visibility="Collapsed"
                      Canvas.Top="0"
                      Canvas.Left="0"
                      Width="{Binding Width, ElementName=CanvasInfo}"
                      Height="{Binding Height, ElementName=CanvasInfo}"
                >
                    <minionPinning:BattlegroundsMinionPinning x:Name="BattlegroundsMinionPinningControl" VerticalAlignment="Bottom" DataContext="{Binding BattlegroundsMinionPinningViewModel, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}" />
                    <minionPinning:BattlegroundsMinionPinningShop x:Name="BgsMinionPinningShop" DataContext="{Binding BattlegroundsMinionPinningViewModel, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"/>
                </Grid>
                <overlay:BattlegroundsTimewarpPanel x:Name="TimewarpNotificationPanel" Visibility="Collapsed" Canvas.Right="0"/>

                <chinaModule:ChinaModulePanel x:Name="ChinaModulePanel" Canvas.Top="0" Canvas.Left="0" Visibility="Collapsed" ext:OverlayExtensions.IsOverlayHitTestVisible="True"
                                              DataContext="{Binding ChinaModuleVM, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"/>
                <bgsAutomation:AutomationLogPanel x:Name="AutomationLogPanel" Canvas.Top="0" Canvas.Left="220" Visibility="Collapsed" ext:OverlayExtensions.IsOverlayHitTestVisible="True"
                                                  DataContext="{Binding AutomationLogVM, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"/>

                <!-- hover trigger region shadowing BgsTopBar, a visible mask swallows hover
                     events for the whole top right corner (minion browser, top bar buttons) -->
                <Grid Background="Black" Opacity="0.01" x:Name="BgsTopBarMask" Canvas.Right="0" Canvas.Top="0"
                      Visibility="{Binding Visibility, ElementName=BgsTopBar}"
                      RenderTransform="{Binding RenderTransform, ElementName=BgsTopBar}"
                      RenderTransformOrigin="1,0"
                      Width="350"
                      Height="120"
                      ext:OverlayExtensions.IsOverlayHoverVisible="True"
                      IsHitTestVisible="False"
                      MouseEnter="BgsMinionsFilterCover_OnMouseEnter"
                      MouseLeave="BgsMinionsFilterCover_OnMouseLeave" />

                <inspiration:BattlegroundsInspiration
                    x:Name="BattlegroundsInspiration" Visibility="Collapsed" Canvas.Top="0" Canvas.Left="0"
                    ext:OverlayExtensions.IsOverlayHitTestVisible="True"
                    DataContext="{Binding BattlegroundsInspirationViewModel, RelativeSource={RelativeSource AncestorType=windows:OverlayWindow}}"
                    />

                <!-- The tooltip needs to stay the bottom item to ensure they are always rendered on top -->
                <Grid Name="OverlayTooltip" IsHitTestVisible="False"/>
            </Canvas>
    </Grid>
</Window>
