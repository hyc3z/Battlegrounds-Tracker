<controls:MetroWindow x:Class="Hearthstone_Deck_Tracker.Windows.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:local="clr-namespace:Hearthstone_Deck_Tracker"
                      xmlns:options="clr-namespace:Hearthstone_Deck_Tracker.FlyoutControls.Options.Overlay"
                      xmlns:error="clr-namespace:Hearthstone_Deck_Tracker.Controls.Error"
                      xmlns:lex="http://wpflocalizeextension.codeplex.com"
                      lex:LocalizeDictionary.DesignCulture="en"
                      lex:ResxLocalizationProvider.DefaultAssembly="BattlegroundsTracker"
                      lex:ResxLocalizationProvider.DefaultDictionary="Strings"
                      Title="Battlegrounds Tracker" Height="700" Width="960"
                      MinHeight="560" MinWidth="820"
                      Closing="Window_Closing"
                      Icon="{StaticResource AppIcon}"
                      StateChanged="MetroWindow_StateChanged" Loaded="MetroWindow_Loaded"
                      BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColorBrush}" CornerRadius="3" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSession" Content="Session Results" Padding="10,4" Margin="4,0" Click="BtnSession_OnClick"/>
                    <Button x:Name="BtnDiscord" Content="Discord" Padding="10,4" Margin="4,0" Click="BtnDiscord_OnClick"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Battlegrounds Tracker" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="TextBlockStatus" Text="Waiting for Hearthstone..." FontSize="12" Foreground="White" Opacity="0.85" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="0,8,0,0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Overlay" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Opacity" Width="140" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderOverlayOpacity" Minimum="10" Maximum="100" Width="280" VerticalAlignment="Center"
                                    ValueChanged="SliderOverlayOpacity_OnValueChanged"/>
                            <TextBlock x:Name="LblOverlayOpacity" Width="50" VerticalAlignment="Center" TextAlignment="Right"/>
                        </StackPanel>
                        <CheckBox x:Name="CheckboxHideOverlay" Content="Hide overlay" Margin="0,8,0,0" Click="CheckboxHideOverlay_OnClick"/>
                        <CheckBox x:Name="CheckboxHideInMenu" Content="Hide overlay in menu" Margin="0,4,0,0" Click="CheckboxHideInMenu_OnClick"/>
                        <CheckBox x:Name="CheckboxHideInBackground" Content="Hide overlay while Hearthstone is in the background" Margin="0,4,0,0" Click="CheckboxHideInBackground_OnClick"/>
                        <CheckBox x:Name="CheckboxUseAnimations" Content="Enable animations" Margin="0,4,0,0" Click="CheckboxUseAnimations_OnClick"/>

                        <TextBlock Text="Windows" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <CheckBox x:Name="CheckboxShowBattlegroundsSessionOnStart" Content="Show session recap window on start" Margin="0,4,0,0" Click="CheckboxShowSessionOnStart_OnClick"/>
                        <CheckBox x:Name="CheckboxShowBattlegroundsMechanicWindow" Content="Show Battlegrounds mechanic window" Margin="0,4,0,0" Click="CheckboxShowMechanicWindow_OnClick"/>

                        <TextBlock Text="Hearthstone" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <TextBlock x:Name="TextBlockHearthstoneStatus" TextWrapping="Wrap" Margin="0,4"/>
                        <Button x:Name="BtnStartHearthstone" Content="Start Hearthstone" Width="150" HorizontalAlignment="Left" Margin="0,6" Click="BtnStartHearthstone_OnClick"/>

                        <TextBlock Text="HSReplay.net account" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <TextBlock x:Name="TextBlockAccountStatus" Text="Not logged in." TextWrapping="Wrap" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Button x:Name="BtnLogin" Content="Log in" Width="110" Margin="0,0,8,0" Click="BtnLogin_OnClick"/>
                            <Button x:Name="BtnLogout" Content="Log out" Width="110" Click="BtnLogout_OnClick"/>
                        </StackPanel>
                        <TextBlock Text="An HSReplay.net account is only required for the Tier7 Battlegrounds features (hero, quest and trinket pick statistics). The tracker itself works without it."
                                   TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Battlegrounds">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <options:OverlayBattlegrounds x:Name="OptionsBattlegrounds"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Errors">
                <error:ErrorList/>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,6,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TextBlockVersion"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TextBlockHearthMirrorStatus"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</controls:MetroWindow>
