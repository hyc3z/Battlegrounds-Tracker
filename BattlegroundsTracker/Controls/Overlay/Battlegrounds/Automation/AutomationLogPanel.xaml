<UserControl x:Class="Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Automation.AutomationLogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:automation="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Automation"
             xmlns:extensions="clr-namespace:Hearthstone_Deck_Tracker.Utility.Extensions"
             extensions:OverlayExtensions.IsOverlayHitTestVisible="True"
             mc:Ignorable="d">
    <d:UserControl.DataContext>
        <automation:AutomationLogViewModel />
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="HeaderActionButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C3135" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Width="350"
            Background="#E6141617"
            BorderBrush="#3F4346"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,3,3">
        <StackPanel>
            <!-- Status header bar (same 32px height as ChinaModulePanel) -->
            <Border Height="32"
                    Background="#141617"
                    Padding="8,0,6,0"
                    Cursor="Hand"
                    extensions:OverlayExtensions.IsOverlayHitTestVisible="True">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0"
                             Width="8" Height="8"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{Binding StatusDotBrush}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="自动: " Foreground="#9AA3AB" /><Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource HeaderActionButtonStyle}"
                                Background="#1D3A4F"
                                Margin="4,0,0,0"
                                extensions:OverlayExtensions.IsOverlayHitTestVisible="True">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding AskAiCommand}" />
                            </Border.InputBindings>
                            <TextBlock Text="AI建议" Foreground="#7CC6FE" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource HeaderActionButtonStyle}"
                                Margin="2,0,0,0"
                                extensions:OverlayExtensions.IsOverlayHitTestVisible="True">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ScreenshotCommand}" />
                            </Border.InputBindings>
                            <TextBlock Text="截图" Foreground="#D8DEE4" FontSize="11" />
                        </Border>
                        <Border Style="{StaticResource HeaderActionButtonStyle}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                Background="#511615"
                                Margin="4,0,0,0"
                                extensions:OverlayExtensions.IsOverlayHitTestVisible="True">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding StopCommand}" />
                            </Border.InputBindings>
                            <TextBlock Text="停止" Foreground="#FFAAAA" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource HeaderActionButtonStyle}"
                                Margin="2,0,0,0"
                                extensions:OverlayExtensions.IsOverlayHitTestVisible="True">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ClearCommand}" />
                            </Border.InputBindings>
                            <TextBlock Text="清空" Foreground="#9AA3AB" FontSize="11" />
                        </Border>
                        <Border Style="{StaticResource HeaderActionButtonStyle}"
                                Margin="2,0,0,0"
                                extensions:OverlayExtensions.IsOverlayHitTestVisible="True">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}" />
                            </Border.InputBindings>
                            <TextBlock Text="{Binding ExpandToggleText}" Foreground="#D8DEE4" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Collapsible log list -->
            <Border BorderBrush="#2E3236"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <ScrollViewer x:Name="LogScrollViewer"
                              MaxHeight="240"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="6,4">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type automation:AutomationLogEntry}">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp}"
                                               Foreground="#7F8C8D"
                                               FontFamily="Consolas"
                                               FontSize="10.5"
                                               Margin="0,1,6,0"
                                               VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Message}"
                                               Foreground="{Binding MessageBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
