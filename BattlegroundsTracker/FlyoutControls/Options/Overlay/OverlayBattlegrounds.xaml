<UserControl x:Class="Hearthstone_Deck_Tracker.FlyoutControls.Options.Overlay.OverlayBattlegrounds"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:options="clr-namespace:Hearthstone_Deck_Tracker.FlyoutControls.Options"
             xmlns:overlay="clr-namespace:Hearthstone_Deck_Tracker.FlyoutControls.Options.Overlay"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture="en"
             lex:ResxLocalizationProvider.DefaultAssembly="BattlegroundsTracker"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d" d:Background="White"
             d:DesignHeight="600" d:DesignWidth="300">
    <StackPanel>
        <CheckBox x:Name="CheckboxShowOverlayInBackground"
                  Content="炉石处于后台时保持显示覆盖层" HorizontalAlignment="Left"
                  Margin="10,5,0,0" VerticalAlignment="Top"
                  Checked="CheckboxShowOverlayInBackground_Checked"
                  Unchecked="CheckboxShowOverlayInBackground_Unchecked" />
        <CheckBox x:Name="CheckboxShowMenuOverlayInBackground"
                  Content="炉石处于后台时保持显示菜单覆盖层" HorizontalAlignment="Left"
                  Margin="10,5,0,0" VerticalAlignment="Top"
                  Checked="CheckboxShowMenuOverlayInBackground_Checked"
                  Unchecked="CheckboxShowMenuOverlayInBackground_Unchecked" />
        <CheckBox x:Name="CheckboxShowBattlegroundsBrowser" Content="显示随从图鉴"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top" Checked="CheckboxShowBattlegroundsBrowser_Checked"
                  Unchecked="CheckboxShowBattlegroundsBrowser_Unchecked" Margin="10,5,0,0" />
        <CheckBox x:Name="CheckboxShowBattlegroundsGuides" Content="显示流派指南"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top" Checked="CheckboxShowBattlegroundsGuides_Checked"
                  IsEnabled="{Binding IsChecked, ElementName=CheckboxShowBattlegroundsBrowser}"
                  Unchecked="CheckboxShowBattlegroundsGuides_Unchecked" Margin="30,5,0,0" />
        <CheckBox x:Name="CheckboxShowMinionBrowserBetweenGames" Content="对局间隙显示随从图鉴"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top" Checked="CheckboxShowMinionBrowserBetweenGames_Checked"
                  IsEnabled="{Binding IsChecked, ElementName=CheckboxShowBattlegroundsBrowser}"
                  Unchecked="CheckboxShowMinionBrowserBetweenGames_Unchecked" Margin="30,5,0,0" />
        <CheckBox x:Name="CheckboxShowBattlegroundsMetaSnapshot" Content="显示环境流派快照"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top" Checked="CheckboxShowBattlegroundsMetaSnapshot_Checked"
                  Unchecked="CheckboxShowBattlegroundsMetaSnapshot_Unchecked" Margin="30,5,0,0" />
        <CheckBox x:Name="CheckboxAlwaysShowBattlegroundsTavernTier7" Content="始终显示 7 本随从"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Checked="CheckboxAlwaysShowBattlegroundsTavernTier7_Checked" Unchecked="CheckboxAlwaysShowBattlegroundsTavernTier7_Unchecked"
                  IsEnabled="{Binding IsChecked, ElementName=CheckboxShowBattlegroundsBrowser}"
                  Margin="30,5,0,0" />
        <CheckBox x:Name="CheckboxShowBattlegroundsTurnCounter" Content="显示回合计时器"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top" Checked="CheckboxShowBattlegroundsTurnCounter_Checked"
                  Unchecked="CheckboxShowBattlegroundsTurnCounter_Unchecked" Margin="10,5,0,0" />
        <CheckBox x:Name="CheckboxShowChinaModuleOverlay" Content="显示断线重连器"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top" Checked="CheckboxCheckboxShowChinaModuleOverlay_Checked"
                  Unchecked="CheckboxCheckboxShowChinaModuleOverlay_Unchecked" Margin="10,5,0,0" />
        <GroupBox Header="Tier7 进阶统计" Margin="5,10,5,5">
            <StackPanel>
                <CheckBox x:Name="CheckboxShowBattlegroundsTavernMarkers" Content="显示酒馆随从标记（钉选）"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top" Checked="CheckboxShowBattlegroundsTavernMarkers_Checked"
                          Unchecked="CheckboxShowBattlegroundsTavernMarkers_Unchecked" Margin="0,5,0,0" />
                <CheckBox x:Name="CheckboxAutoEnableTavernMarkersRecommended" Content="自动启用推荐流派随从标记"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxShowBattlegroundsTavernMarkers}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top" Checked="CheckboxAutoEnableTavernMarkersRecommended_Checked"
                          Unchecked="CheckboxAutoEnableTavernMarkersRecommended_Unchecked" Margin="20,5,0,0" />
                <CheckBox x:Name="CheckboxShowTavernMarkersQuickGuides" Content="显示随从标记快速指引"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxShowBattlegroundsTavernMarkers}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top" Checked="CheckboxShowTavernMarkersQuickGuides_Checked"
                          Unchecked="CheckboxShowTavernMarkersQuickGuides_Unchecked" Margin="20,5,0,0" />
                <CheckBox x:Name="CheckboxEnableTier7" Content="启用 Tier7 覆盖层"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"
                          Checked="CheckboxEnableTier7_Checked" Unchecked="CheckboxEnableTier7_Unchecked" />
                <CheckBox x:Name="CheckboxShowTier7PreLobby" Content="显示开局前大厅面板"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxEnableTier7}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"
                          Checked="CheckboxShowTier7PreLobby_Checked" Unchecked="CheckboxShowTier7PreLobby_Unchecked" />
                <CheckBox x:Name="CheckboxShowBattlegroundsHeroPicking" Content="显示英雄选择统计"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxEnableTier7}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"
                          Checked="CheckboxShowBattlegroundsHeroPicking_Checked" Unchecked="CheckboxShowBattlegroundsHeroPicking_Unchecked"/>
                <CheckBox x:Name="CheckboxShowBattlegroundsQuestPicking" Content="显示任务选择统计"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxEnableTier7}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"
                          Checked="CheckboxShowBattlegroundsQuestPicking_Checked" Unchecked="CheckboxShowBattlegroundsQuestPicking_Unchecked" />
                <CheckBox x:Name="CheckboxAutoShowBattlegroundsTrinketPicking" Content="显示饰品选择统计"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxEnableTier7}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"
                          Checked="CheckboxAutoShowBattlegroundsTrinketPicking_Checked" Unchecked="CheckboxAutoShowBattlegroundsTrinketPicking_Unchecked" />
                <CheckBox x:Name="CheckboxShowTier7CompStats" Content="显示流派统计"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxEnableTier7}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"
                          Checked="CheckboxShowBattlegroundsCompStats_Checked" Unchecked="CheckboxShowBattlegroundsCompStats_Unchecked" />
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Bob's Buddy 战斗模拟" Margin="5,10,5,5">
            <StackPanel>
                <TextBlock Name="TextBobsBuddyDisabled" Foreground="Yellow" Visibility="Collapsed" Margin="0,0,0,5"/>
                <CheckBox x:Name="CheckboxRunCombatSimulations" Content="启用战斗模拟"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Checked="CheckboxRunCombatSimulations_Checked"
                          Unchecked="CheckboxRunCombatSimulations_Unchecked" Margin="0" />
                <CheckBox x:Name="CheckboxShowResultsDuringCombat" Content="战斗阶段显示模拟结果"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxRunCombatSimulations}"
                          Checked="CheckboxShowResultsDuringCombat_Checked"
                          Unchecked="CheckboxShowResultsDuringCombat_Unchecked" Margin="0,5,0,0" />
                <CheckBox x:Name="CheckboxShowResultsDuringShopping" Content="购物阶段显示模拟结果"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxRunCombatSimulations}"
                          Checked="CheckboxShowResultsDuringShopping_Checked"
                          Unchecked="CheckboxShowResultsDuringShopping_Unchecked" Margin="0,5,0,0" />
                <CheckBox x:Name="CheckboxAlwaysShowAverageDamage" Content="始终显示平均伤害"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsChecked, ElementName=CheckboxRunCombatSimulations}"
                          Checked="CheckboxAlwaysShowAverageDamage_Checked"
                          Unchecked="CheckboxAlwaysShowAverageDamage_Unchecked" Margin="0,5,0,0" />
            </StackPanel>
        </GroupBox>
        <GroupBox Header="V2 自动操作 (实验性)" Margin="5,10,5,5">
            <StackPanel>
                <CheckBox x:Name="CheckboxShowBgsAutomationLogOverlay" Content="显示状态日志框"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Checked="CheckboxShowBgsAutomationLogOverlay_Checked"
                          Unchecked="CheckboxShowBgsAutomationLogOverlay_Unchecked" Margin="0" />
                <CheckBox x:Name="CheckboxBgsAutoUpgradeTurn2" Content="第 2 回合自动升本 (T2 升 2 本)"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Checked="CheckboxBgsAutoUpgradeTurn2_Checked"
                          Unchecked="CheckboxBgsAutoUpgradeTurn2_Unchecked" Margin="0,5,0,0" />
                <CheckBox x:Name="CheckboxBgsAutoPositioningApply" Content="点击最优站位按钮时自动拖拽调整 (F8 随时中止)"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Checked="CheckboxBgsAutoPositioningApply_Checked"
                          Unchecked="CheckboxBgsAutoPositioningApply_Unchecked" Margin="0,5,0,0" />
            </StackPanel>
        </GroupBox>
        <GroupBox Header="AI 教练 (OpenAI 兼容接口)" Margin="5,10,5,5">
            <StackPanel>
                <DockPanel Margin="0,2">
                    <TextBlock Text="API 地址" Width="76" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBox x:Name="TextBoxLlmBaseUrl" LostFocus="TextBoxLlmSettings_LostFocus" />
                </DockPanel>
                <DockPanel Margin="0,5,0,2">
                    <TextBlock Text="API Key" Width="76" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <PasswordBox x:Name="PasswordBoxLlmApiKey" LostFocus="PasswordBoxLlmApiKey_LostFocus" />
                </DockPanel>
                <DockPanel Margin="0,5,0,2">
                    <TextBlock Text="模型名称" Width="76" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBox x:Name="TextBoxLlmModel" LostFocus="TextBoxLlmSettings_LostFocus" />
                </DockPanel>
                <TextBlock Text="兼容 OpenAI / DeepSeek / 硅基流动 / 通义千问 / Kimi / 本地 Ollama (http://localhost:11434/v1) 等接口。"
                           Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,4" />
                <CheckBox x:Name="CheckboxBgsLlmAutoAdvise" Content="每回合购物开始时自动给出 AI 建议"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Checked="CheckboxBgsLlmAutoAdvise_Checked"
                          Unchecked="CheckboxBgsLlmAutoAdvise_Unchecked" Margin="0,2,0,6" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnTestLlmConnection" Content="测试连接" Width="110" Click="BtnTestLlmConnection_Click" />
                    <TextBlock x:Name="TextBlockLlmTestResult" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="对局战绩" Margin="5,10,5,5">
            <StackPanel>
                <CheckBox
                    x:Name="CheckboxShowSessionRecap"
                    Content="启用对局战绩覆盖层"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Checked="CheckboxShowSessionRecap_Checked"
                    Unchecked="CheckboxShowSessionRecap_Unchecked"
                    Margin="0"
                />
                <CheckBox
                    x:Name="CheckboxShowSessionRecapBetweenGames"
                    Content="对局间隙显示战绩面板"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsEnabled="{Binding IsChecked, ElementName=CheckboxShowSessionRecap}"
                    Checked="CheckboxShowSessionRecapBetweenGames_Checked"
                    Unchecked="CheckboxShowSessionRecapBetweenGames_Unchecked"
                    Margin="0,5,0,0"
                />
                <CheckBox
                    x:Name="CheckboxShowExternalWindow"
                    Content="显示独立对局战绩窗口"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Checked="CheckboxShowExternalWindow_Checked"
                    Unchecked="CheckboxShowExternalWindow_Unchecked"
                    Margin="0,5,0,0"
                />
                <CheckBox
                    x:Name="CheckboxShowMinionsAvailable"
                    Content="显示本局可用种族"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Checked="CheckboxShowMinionsAvailable_Checked"
                    Unchecked="CheckboxShowMinionsAvailable_Unchecked"
                    Margin="0,5,0,0"
                />
                <CheckBox
                    x:Name="CheckboxShowMinionsBanned"
                    Content="显示本局禁用种族"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Checked="CheckboxShowMinionsBanned_Checked"
                    Unchecked="CheckboxShowMinionsBanned_Unchecked"
                    Margin="0,5,0,0"
                />
                <CheckBox
                    x:Name="CheckboxShowStartCurrentMMR"
                    Content="显示起始与当前分数 (MMR)"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Checked="CheckboxShowStartCurrentMMR_Checked"
                    Unchecked="CheckboxShowStartCurrentMMR_Unchecked"
                    Margin="0,5,0,0"
                />
                <CheckBox
                    x:Name="CheckboxShowLatestGames"
                    Content="显示本时段最近对局"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Checked="CheckboxShowLatestGames_Checked"
                    Unchecked="CheckboxShowLatestGames_Unchecked"
                    Margin="0,5,0,0"
                />
                <StackPanel Orientation="Horizontal">
                    <Label Content="缩放比例" />
                    <Slider
                        x:Name="SliderSessionRecapScaling"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="150"
                        Value="{Binding SessionRecapScaling, RelativeSource={RelativeSource AncestorType=overlay:OverlayBattlegrounds}, Delay=100}"
                        SmallChange="1" LargeChange="10" Minimum="50" Maximum="200"
                    />
                    <TextBox
                        PreviewTextInput="TextBoxSessionRecapScaling_OnPreviewTextInput"
                        Text="{Binding SessionRecapScaling, RelativeSource={RelativeSource AncestorType=overlay:OverlayBattlegrounds}}"
                        Margin="5,0,0,0" Width="50"
                    />
                </StackPanel>
                <DockPanel Margin="0,5,0,0">
                    <Button
                        Width="150"
                        Content="重置"
                        Command="{Binding ResetSessionCommand, RelativeSource={RelativeSource AncestorType=overlay:OverlayBattlegrounds}}"
                        VerticalAlignment="Top"
                        Margin="0,3,0,0"
                        DockPanel.Dock="Right"
                    />
                    <Label Content="重置本时段战绩" DockPanel.Dock="Left"/>
                </DockPanel>
                <TextBlock
                    Text="重置后将清空本时段的战绩记录，并以当前分数作为新的起始分数。"
                    Foreground="Gray"
                    TextWrapping="WrapWithOverflow"
                    TextAlignment="Left"
                    Margin="5,0,5,0"
                />
                <DockPanel Margin="0,5,0,0">
                    <Button Name="BtnUnlockOverlay" Content="解锁" Width="150"
                    Click="BtnUnlockOverlay_Click" DockPanel.Dock="Right" />
                    <Label Content="移动 / 调整面板" DockPanel.Dock="Left"/>
                </DockPanel>
                <DockPanel Margin="0,5,0,0">
                    <Button x:Name="BtnResetOverlay" Content="重置" Width="150" Click="BtnResetOverlay_Click"
                    DockPanel.Dock="Right" />
                    <Label Content="重置面板位置" DockPanel.Dock="Left" />
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <Button x:Name="OverlayHelpButton"
            Click="OverlayHelpButtonClick"
            Foreground="#FF47B1DF"
            Visibility="Visible"
            Content="酒馆战棋覆盖层说明"/>
    </StackPanel>
</UserControl>
